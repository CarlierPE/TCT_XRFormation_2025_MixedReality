    - target: {fileID: 7517174337173555971, guid: f30e7d6744b9d6e4e89103e86099de3a, type: 3}
      propertyPath: 'textContents.Array.data[0]'
      value: "D\xE8s que vous \xEAtes hors de danger, pr\xE9venez imm\xE9diatement
        les pompiers en appelant le 112. Donnez des indications claires et pr\xE9cises."
      objectReference: {fileID: 0}
