    - target: {fileID: 8655823270767389670, guid: f30e7d6744b9d6e4e89103e86099de3a, type: 3}
      propertyPath: textContents.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8655823270767389670, guid: f30e7d6744b9d6e4e89103e86099de3a, type: 3}
      propertyPath: 'textContents.Array.data[0]'
      value: 'ne surtout pas prendre l''ascenseur par-ce que '
      objectReference: {fileID: 0}
    - target: {fileID: 8655823270767389670, guid: f30e7d6744b9d6e4e89103e86099de3a, type: 3}
      propertyPath: 'textContents.Array.data[1]'
      value: "un ascenseur peut se retrouver bloqu\xE9 si l'alimentation est coup\xE9e."
      objectReference: {fileID: 0}
    - target: {fileID: 8655823270767389670, guid: f30e7d6744b9d6e4e89103e86099de3a, type: 3}
      propertyPath: 'textContents.Array.data[2]'
      value: "D\xE9gagement de fum\xE9e : la cabine peut devenir une zone dangereuse
        en raison de l'inhalation de fum\xE9es toxiques."
      objectReference: {fileID: 0}
    - target: {fileID: 8655823270767389670, guid: f30e7d6744b9d6e4e89103e86099de3a, type: 3}
      propertyPath: 'textContents.Array.data[3]'
      value: "Propagation des flammes : certaines cages d'ascenseurs peuvent faciliter
        la propagation du feu entre les \xE9tages."
      objectReference: {fileID: 0}
    - target: {fileID: 9068887908796665854, guid: f30e7d6744b9d6e4e89103e86099de3a, type: 3}
