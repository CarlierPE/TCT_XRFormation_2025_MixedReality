    - target: {fileID: 3591623091492035339, guid: f30e7d6744b9d6e4e89103e86099de3a, type: 3}
      propertyPath: 'textContents.Array.data[0]'
      value: "Veuillez lire les r\xE8gles."
      objectReference: {fileID: 0}
    - target: {fileID: 3591623091492035339, guid: f30e7d6744b9d6e4e89103e86099de3a, type: 3}
      propertyPath: 'textContents.Array.data[1]'
      value: "n'oubliez pas qu'apr\xE8s \xEAtre sorti, dites aux pompier o\xF9 se
        situe le d\xE9but d'incendie"
      objectReference: {fileID: 0}
    - target: {fileID: 3591623091492035339, guid: f30e7d6744b9d6e4e89103e86099de3a, type: 3}
