      value: 
      objectReference: {fileID: 857579768001180419}
    - target: {fileID: 8469661745480815938, guid: f30e7d6744b9d6e4e89103e86099de3a, type: 3}
      propertyPath: canvas
      value: 
      objectReference: {fileID: 8052860308392303817}
