--- !u!114 &8469661745480815938
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2037691967761874643}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: abf1a08cc12f28a41884a53e7b6d9bce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  autoPlay: 0
  changeInterval: 999
  displayText: {fileID: 0}
  canvas: {fileID: 0}
  textContents:
  - " Voici une porte coupe-feu. Son installation est obligatoire dans les b\xE2timents
    destin\xE9s au public, les immeubles d\u2019habitation et les b\xE2timents industriels."
  - "Celles-ci servent principalement \xE0 \xE9viter la propagation du feu et \xE0
    emp\xEAcher la fum\xE9e de se r\xE9pandre. "
  - "Elles doivent toujours \xEAtre plac\xE9es de mani\xE8re \xE0 compartimenter
    les b\xE2timents et \xE0 garder les issues de secours praticables.  "
  - 'Ainsi, en cas d''incendie, n''oubliez pas de les refermer. '
  buttonToShow: {fileID: 0}
  manualNextButton: {fileID: 0}
