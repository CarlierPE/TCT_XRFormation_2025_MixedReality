--- !u!114 &8655823270767389670
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3283782696849422163}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: abf1a08cc12f28a41884a53e7b6d9bce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  autoPlay: 0
  changeInterval: 999
  displayText: {fileID: 0}
  canvas: {fileID: 0}
  textContents:
  - "\xC9l\xE9ment 0 : Ne prenez surtout pas l'ascenseur en cas d'incendie, car il
    se bloque si l'alimentation est coup\xE9e. "
  - "La cabine pourrait alors devenir une zone dangereuse en raison de l'inhalation
    de fum\xE9es toxiques, de la chaleur ou encore de la rupture du c\xE2ble. "
  - "Les cages d'ascenseur facilitent la propagation du feu entre les \xE9tages. "
  buttonToShow: {fileID: 0}
  manualNextButton: {fileID: 0}
