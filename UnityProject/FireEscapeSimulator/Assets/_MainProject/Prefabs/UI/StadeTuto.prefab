--- !u!114 &2170510584085285613
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6759783852052906140}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: abf1a08cc12f28a41884a53e7b6d9bce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  autoPlay: 0
  changeInterval: 999
  displayText: {fileID: 0}
  canvas: {fileID: 0}
  textContents:
  - "\xC9l\xE9ment 0 : Regardons maintenant l'alarme incendie. Elle sert principalement
    \xE0 avertir rapidement les occupants d'un b\xE2timent afin qu'ils puissent \xE9vacuer
    en toute s\xE9curit\xE9. "
  - "Celle-ci doit toujours \xEAtre d\xE9clench\xE9e en priorit\xE9 en cas d\u2019incendie,
    pour pouvoir pr\xE9venir tout le monde rapidement. "
  - " Dans ce b\xE2timent, elle est reli\xE9e aux d\xE9tecteurs de fum\xE9e et au
    num\xE9ro des pompiers. Dans d\u2019autres b\xE2timents, elle pourrait permettre
    de d\xE9verrouiller les issues de secours. Ainsi, \xE0 cause de toutes ces variables
    possibles, l\u2019alarme doit toujours \xEAtre d\xE9clench\xE9e manuellement
    et vous devez appeler les pompiers d\xE8s que vous \xEAtes hors de danger."
  buttonToShow: {fileID: 0}
  manualNextButton: {fileID: 0}
