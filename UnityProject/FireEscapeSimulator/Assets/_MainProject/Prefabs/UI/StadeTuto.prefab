--- !u!114 &7741982573264241920
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1263045711652785982}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: abf1a08cc12f28a41884a53e7b6d9bce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  autoPlay: 0
  changeInterval: 999
  displayText: {fileID: 0}
  canvas: {fileID: 0}
  textContents:
  - "Un extincteur est un appareil de lutte contre les incendies. Il sert \xE0 \xE9teindre
    un d\xE9part de feu."
  - "Utilisez-le \xE0 la base des flammes pour limiter leur propagation. "
  - "Ne l'utilisez pas si le feu est d\xE9j\xE0 hors de contr\xF4le."
  buttonToShow: {fileID: 0}
  manualNextButton: {fileID: 0}
